OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# OpenAI 兼容接口的基础地址；直连官方接口时可留空。
# 例如：https://api.openai.com/v1
# 后端任务产物根目录。相对路径以 `backend/` 为基准。
ARTIFACT_ROOT=data/jobs

# 开发阶段是否保留更多调试产物。
ENABLE_DEV_ARTIFACTS=true

# workbench 初始化与多轮编辑的 prompt 模板路径。相对路径以 `backend/` 为基准。
WORKBENCH_INIT_PROMPT_PATH=app/prompts/workbench_init.md
WORKBENCH_EDIT_PROMPT_PATH=app/prompts/workbench_edit.md

# 当模型返回结构不合法时，最多重试的校验次数。
WORKBENCH_MAX_VALIDATION_RETRIES=1
